# Supabase (required for attendee profile updates)
# Get these from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Setup checklist:
# 1. Run supabase/migrations/20260529000000_profile_overrides.sql in SQL Editor
# 2. Run supabase/seed/allowed_badges.sql in SQL Editor
# 3. Deploy edge functions:
#    supabase functions deploy update-profile
#    supabase functions deploy user-saved-data
# 4. Run supabase/migrations/20260529000002_user_saved_data.sql in SQL Editor
# 4. Add the same VITE_* vars to GitHub repo Settings → Secrets and variables → Actions
